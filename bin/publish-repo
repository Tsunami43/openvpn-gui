#!/bin/sh
# Uploads a repository built by bin/repo to its rolling GitHub pre-release
# (repo-x86_64, repo-aarch64), creating it if needed. The new database
# replaces the old one first, then packages no longer in it are removed, so
# pacman never sees a database without its packages. Needs gh with GH_TOKEN
# and GH_REPO set.
#
#   bin/publish-repo RELEASE_TAG REPO_DIR
set -eu

release="$1"
cd "$2"

gh release view "$release" >/dev/null 2>&1 \
  || gh release create "$release" --prerelease --target main \
       --title "pacman repository (${release#repo-})" \
       --notes "The signed pacman repository for OpenVPN GUI. See the README for how to install."

gh release upload "$release" openvpn-gui.db openvpn-gui.db.sig openvpn-gui.files openvpn-gui.files.sig \
  ./*.pkg.tar.* --clobber

gh release view "$release" --json assets -q '.assets[].name' | while read -r asset; do
  [ -e "$asset" ] || gh release delete-asset "$release" "$asset" --yes
done
