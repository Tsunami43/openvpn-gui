// Lets OpenVPN GUI switch a tunnel on without asking for a password each time.
// Only for /usr/bin/openvpn started through pkexec, and only for members of
// the wheel group sitting at an active local session. Delete this file (or
// uninstall openvpn-gui) to be asked again.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/bin/openvpn" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
